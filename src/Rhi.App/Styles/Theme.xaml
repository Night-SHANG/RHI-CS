<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="CanvasBrush" Color="#FAFAF8" />
   <SolidColorBrush x:Key="PanelBrush" Color="#F2F5F8" />
   <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
   <SolidColorBrush x:Key="LineBrush" Color="#DDE3EC" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Dark">
   <SolidColorBrush x:Key="CanvasBrush" Color="#101827" />
   <SolidColorBrush x:Key="PanelBrush" Color="#162133" />
   <SolidColorBrush x:Key="CardBrush" Color="#1D293D" />
   <SolidColorBrush x:Key="LineBrush" Color="#35445D" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="CanvasBrush" Color="#101827" />
   <SolidColorBrush x:Key="PanelBrush" Color="#162133" />
   <SolidColorBrush x:Key="CardBrush" Color="#1D293D" />
   <SolidColorBrush x:Key="LineBrush" Color="#35445D" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="PageTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="Margin" Value="0,0,0,12" />
 </Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
 </Style>
</ResourceDictionary>
