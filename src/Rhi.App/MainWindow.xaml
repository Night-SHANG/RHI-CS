<Window x:Class="Rhi.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RHI-CS">
 <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" RequestedTheme="Light" UseLayoutRounding="True">
  <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
   <Grid>
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <FontIcon Glyph="&#xECA5;" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" FontSize="24" />
     <TextBlock Text="RHI-CS" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
     <Grid><ToggleButton x:Name="GamesNav" Style="{StaticResource NavigationTab}" Click="Games_Click" />
      <Border x:Name="GamesIndicator" Height="3" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlHighlightAccentBrush}" /></Grid>
     <Grid><ToggleButton x:Name="LibrariesNav" Style="{StaticResource NavigationTab}" Click="Libraries_Click" />
      <Border x:Name="LibrariesIndicator" Height="3" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlHighlightAccentBrush}" /></Grid>
     <Grid><ToggleButton x:Name="SettingsNav" Style="{StaticResource NavigationTab}" Click="Settings_Click" />
      <Border x:Name="SettingsIndicator" Height="3" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlHighlightAccentBrush}" /></Grid>
    </StackPanel>
   </Grid>
  </Border>
  <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  <Border Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="TaskText" TextWrapping="Wrap" Foreground="{ThemeResource TextBrush}" />
     <Grid Height="11"><ProgressBar x:Name="TaskProgressBar" IsIndeterminate="True" Visibility="Collapsed" Height="3" VerticalAlignment="Bottom" /></Grid>
    </StackPanel>
    <Button x:Name="StopButton" Grid.Column="1" Click="Stop_Click" Visibility="Collapsed" />
    <Button x:Name="ResultButton" Grid.Column="2" Click="Result_Click" />
   </Grid>
  </Border>
 </Grid>
</Window>
